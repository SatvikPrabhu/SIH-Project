# ==============================================================================
# SIH-Project Root .gitignore
# Geospatial AI & Drone 3D Vision Pipeline (DUSt3R, 3DGS, Node.js, React + Vite)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Node.js & Dependencies
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Web Build Outputs & Next.js cache
frontend/dist/
frontend/dist-ssr/
dist/
build/
out/
.next/

# ------------------------------------------------------------------------------
# 2. Python Environments, Bytecode & Caches
# ------------------------------------------------------------------------------
__pycache__/
*/__pycache__/
**/__pycache__/
**/*.py[cod]
*$py.class
*.so
*.pyd

# Virtual Environments
venv/
.venv/
env/
ENV/
generation/venv/
*/venv/
*/.venv/
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Type Checking
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 3. Machine Learning Model Weights & Checkpoints
# ------------------------------------------------------------------------------
*.pth
*.pt
*.ckpt
*.bin
*.onnx
*.safetensors
*.tflite
*.h5

# Specific Model Weight Folders
checkpoints/
**/checkpoints/
weights/
**/weights/
generation/dust3r/checkpoints/*
yolov8*.pt
DUSt3R_*.pth

# ------------------------------------------------------------------------------
# 4. Environment Variables & Secret Credentials
# ------------------------------------------------------------------------------
.env
.env.*
*.env
backend/.env
frontend/.env
!.env.example
!.env.sample

# ------------------------------------------------------------------------------
# 5. Storage, Pipeline Intermediates & Video Uploads
# ------------------------------------------------------------------------------
# Raw input videos & flight logs
storage/inputs/*
storage/inputs/**/*
!storage/inputs/.gitkeep

# Reconstructed job outputs, frame extractions, camera poses, colmap databases
storage/outputs/*
storage/outputs/**/*
!storage/outputs/.gitkeep

# Cache & Temp directories
storage/temp/
storage/frames/
storage/cache/
storage/uploads/

# Large 3D Point Clouds, GIS tiles, Meshes & LIDAR
*.ply
*.las
*.laz
*.pnts
*.b3dm
*.geotiff
*.tif
*.tiff

# Ignore generated job models in frontend public, but allow gitkeep
frontend/public/models/*
!frontend/public/models/.gitkeep
!frontend/public/models/model.glb

# ------------------------------------------------------------------------------
# 6. IDEs, Editors & Operating System Artefacts
# ------------------------------------------------------------------------------
# JetBrains / PyCharm / WebStorm
.idea/
*.iml
*.iws

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# OS & Filesystem Artefacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Windows crash / dump files
*.stackdump
*.dmp
