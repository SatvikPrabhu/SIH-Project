# ==============================================================================
# Geo3D Vision - Global .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python & Virtual Environments
# ------------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
pyvenv.cfg

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Python distribution & packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing, typing & linters
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.nox/
.tox/

# ------------------------------------------------------------------------------
# 2. Node.js, Frontend & Build Outputs (Vite / Next.js)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build artifacts
frontend/dist/
dist/
**/dist/
.next/
**/out/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# TypeScript build info & caches
next-env.d.ts
*.tsbuildinfo
.eslintcache

# Cesium generated build copy
public/cesium/
frontend/public/cesium/

# ------------------------------------------------------------------------------
# 3. Dynamic Storage, Heavy Video Inputs & 3D Reconstruction Outputs
# ------------------------------------------------------------------------------
storage/inputs/*
!storage/inputs/.gitkeep
storage/outputs/*
!storage/outputs/.gitkeep

backend/storage/*
!backend/storage/.gitkeep

# Large 3D geometry & GIS rasters generated at runtime
*.ply
*.las
*.laz
*.obj
*.fbx
*.glb
*.gltf
*.tif
*.tiff

# Raw media files
*.mp4
*.mov
*.avi
*.mkv
*.wmv
*.flv
*.webm

# Large ML model checkpoints & weights
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.onnx

# Database files
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# ------------------------------------------------------------------------------
# 4. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env*
!.env.example
*.local

# ------------------------------------------------------------------------------
# 5. OS & IDE Specific Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs & Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

checkpoints/
*.pth
*.ply
*.glb