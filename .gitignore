# ==============================================================================
# SIH-Project Root .gitignore
# Geospatial AI & Drone 3D Vision Pipeline (DUSt3R, 3DGS, Node.js, React + Vite)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Node.js & Dependencies
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Web Build Outputs & Next.js cache
frontend/dist/
frontend/dist-ssr/
dist/
build/
out/
.next/

# ------------------------------------------------------------------------------
# 2. Python Environments, Bytecode & Caches
# ------------------------------------------------------------------------------
__pycache__/
*/__pycache__/
**/__pycache__/
**/*.py[cod]
*$py.class
*.so
*.pyd

# Virtual Environments
venv/
.venv/
env/
ENV/
generation/venv/
*/venv/
*/.venv/
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Type Checking
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 3. Machine Learning Model Weights & Checkpoints
# ------------------------------------------------------------------------------
*.pth
*.pt
*.ckpt
*.bin
*.onnx
*.safetensors
*.tflite
*.h5

# Specific Model Weight Folders
checkpoints/
**/checkpoints/
weights/
**/weights/
generation/dust3r/checkpoints/*
yolov8*.pt
DUSt3R_*.pth

# ------------------------------------------------------------------------------
# 4. Environment Variables & Secret Credentials
# ------------------------------------------------------------------------------
.env
.env.*
*.env
backend/.env
frontend/.env
!.env.example
!.env.sample

# ------------------------------------------------------------------------------
# 5. Storage, Pipeline Intermediates & Video Uploads
# ------------------------------------------------------------------------------
# Raw input videos & flight logs
storage/inputs/*
storage/inputs/**/*
!storage/inputs/.gitkeep

# Reconstructed job outputs, frame extractions, camera poses, colmap databases
storage/outputs/*
storage/outputs/**/*
!storage/outputs/.gitkeep

# Cache & Temp directories
storage/temp/
storage/frames/
storage/cache/
storage/uploads/

# Large 3D Point Clouds, GIS tiles, Meshes & LIDAR
*.ply
*.las
*.laz
*.pnts
*.b3dm
*.geotiff
*.tif
*.tiff

# Ignore generated job models in frontend public, but allow gitkeep
frontend/public/models/*
!frontend/public/models/.gitkeep
!frontend/public/models/model.glb

# ------------------------------------------------------------------------------
# 6. IDEs, Editors & Operating System Artefacts
# ------------------------------------------------------------------------------
# JetBrains / PyCharm / WebStorm
.idea/
*.iml
*.iws

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# OS & Filesystem Artefacts
# Testing, typing & linters
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.nox/
.tox/

# ------------------------------------------------------------------------------
# 2. Node.js, Frontend & Build Outputs (Vite / Next.js)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build artifacts
frontend/dist/
dist/
**/dist/
.next/
**/out/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# TypeScript build info & caches
next-env.d.ts
*.tsbuildinfo
.eslintcache

# Cesium generated build copy
public/cesium/
frontend/public/cesium/

# ------------------------------------------------------------------------------
# 3. Dynamic Storage, Heavy Video Inputs & 3D Reconstruction Outputs
# ------------------------------------------------------------------------------
storage/inputs/*
!storage/inputs/.gitkeep
storage/outputs/*
!storage/outputs/.gitkeep

backend/storage/*
!backend/storage/.gitkeep

# Large 3D geometry & GIS rasters generated at runtime
*.ply
*.las
*.laz
*.obj
*.fbx
*.glb
*.gltf
*.tif
*.tiff

# Raw media files
*.mp4
!frontend/src/assets/*.mp4
*.mov
*.avi
*.mkv
*.wmv
*.flv
*.webm

# Large ML model checkpoints & weights
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.onnx

# Database files
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

